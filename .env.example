# OpenRouter (LLM generation — required by the assignment)
OPENROUTER_API_KEY=

# Embedding provider: nvidia | openrouter | groq (all free tiers)
EMBEDDING_PROVIDER=nvidia
# nvidia: key from https://build.nvidia.com (starts with nvapi-, free, 40 RPM)
# groq:   key from https://console.groq.com/keys (starts with gsk_)
# openrouter: key from https://openrouter.ai/keys
EMBEDDING_API_KEY=
# Optional overrides (defaults come from the provider preset):
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# LLM generation (free tier)
# Default: NVIDIA free chat (same key as EMBEDDING_API_KEY works).
# To use OpenRouter instead: LLM_BASE_URL=https://openrouter.ai/api/v1 and
# LLM_API_KEY=<openrouter key>
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-nano-3-30b-a3b
# Comma-separated fallbacks tried if LLM_MODEL is unavailable (same endpoint)
LLM_FALLBACK_MODELS=nvidia/nemotron-3-nano-30b-a3b
# Cross-provider fallback (used when every model above is unavailable).
# Defaults to the NVIDIA free chat endpoint and reuses EMBEDDING_API_KEY when
# LLM_FALLBACK_API_KEY is empty.
# LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

# Qdrant (create a free cluster at https://cloud.qdrant.io,
# or run locally: docker run -p 6333:6333 qdrant/qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_rag

# Retrieval tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.30

# Chunking (in words)
CHUNK_SIZE=400
CHUNK_OVERLAP=60
